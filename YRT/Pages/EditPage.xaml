<UserControl x:Class="YRT.Pages.EditPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True" Drop="Page_Drop" DragEnter="Page_DragEnter" DragLeave="Page_DragLeave">
    <UserControl.Resources>
        <FontFamily x:Key="IconFont">Segoe MDL2 Assets</FontFamily>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" MaxWidth="1100">
            <TextBlock Style="{StaticResource PageTitle}" Text="编辑" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="导入任意 Minecraft 资源包（zip / mcpack / 目录，或直接扫描游戏目录），浏览并编辑包内文件与 pack.mcmeta 详情，改完整包导出。所有改动在工作副本内进行，不影响原文件。" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,14,0,0" MaxWidth="1100">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ============ 左列：导入来源 ============ -->
            <StackPanel Grid.Column="0">
                <Border Style="{StaticResource Card}" Margin="0">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="游戏里的资源包" Style="{StaticResource SectionTitle}" />
                            <Button Content="扫描" HorizontalAlignment="Right" Padding="12,4"
                                    FontSize="12" Command="{Binding ScanGameCommand}"
                                    IsEnabled="{Binding Path=Scanning, Converter={StaticResource InverseBoolToVis}}" />
                        </Grid>
                        <ListBox ItemsSource="{Binding GamePacks}" SelectedItem="{Binding SelectedGamePack}"
                                 Height="210" Margin="0,8,0,0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="1,0">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Style="{StaticResource HintText}" FontSize="11"
                                                   Text="{Binding Source}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Style="{StaticResource PrimaryButton}" Content="导入编辑" Padding="16,6"
                                    Command="{Binding ImportGamePackCommand}" />
                            <Button Content="浏览文件…" Padding="14,6" Margin="8,0,0,0"
                                    Command="{Binding BrowseCommand}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource HintText}" Margin="0,8,0,0"
                                   Text="扫描范围与深度同「设置 → 扫描」；zip / mcpack / 文件夹也可以直接拖进本页。" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="包详情" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding PackName, StringFormat=包名：{0}}"
                                   Style="{StaticResource FieldLabel}" Margin="0,8,0,0"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Description, StringFormat=描述：{0}}"
                                   Style="{StaticResource HintText}" Margin="0,4,0,0"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding FormatText, StringFormat=格式版本：{0}}"
                                   Style="{StaticResource HintText}" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding Stats}" Style="{StaticResource HintText}" Margin="0,4,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="编辑清单" Padding="12,5" Command="{Binding EditMetaCommand}"
                                    IsEnabled="{Binding HasPack}" />
                            <Button Content="工作目录" Padding="12,5" Margin="8,0,0,0"
                                    Command="{Binding OpenDirCommand}" />
                            <Button Content="关闭包" Padding="12,5" Margin="8,0,0,0"
                                    Command="{Binding ClosePackCommand}" IsEnabled="{Binding HasPack}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ============ 右列：文件编辑 ============ -->
            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource Card}" Margin="0">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="包内文件" Style="{StaticResource SectionTitle}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="搜索：" Style="{StaticResource HintText}"
                                           VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                                         Width="170" Padding="6,3" FontSize="12" />
                            </StackPanel>
                        </Grid>
                        <!-- 分类筛选条 -->
                        <ListBox ItemsSource="{Binding Categories}" SelectedIndex="{Binding SelectedCategory}"
                                 HorizontalAlignment="Left" Margin="0,8,0,0"
                                 Background="Transparent" BorderThickness="0" Padding="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Hidden">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}" />
                                    <Setter Property="FontSize" Value="12.5" />
                                    <Setter Property="Cursor" Value="Hand" />
                                    <Setter Property="Margin" Value="0,0,6,0" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="bd" CornerRadius="7" Padding="10,4"
                                                        Background="{DynamicResource TrackBrush}">
                                                    <ContentPresenter VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background"
                                                                Value="{DynamicResource HoverBrush}" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="bd" Property="Background"
                                                                Value="{DynamicResource PrimaryBrush}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                        <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}"
                                 Height="240" Margin="0,8,0,0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="1,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding RelPath}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding RelPath}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Category}"
                                                   Style="{StaticResource HintText}" Margin="10,0,0,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding SizeText}"
                                                   Style="{StaticResource HintText}" Margin="10,0,0,0" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <!-- 图片预览 -->
                        <Border Height="170" Margin="0,8,0,0" CornerRadius="10"
                                Background="{DynamicResource TrackBrush}"
                                Visibility="{Binding HasPreview, Converter={StaticResource BoolToVis}}">
                            <Image Source="{Binding PreviewImage}" Stretch="Uniform" Margin="10"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor" />
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="重命名" Padding="14,5" Command="{Binding RenameCommand}" />
                            <Button Content="删除" Padding="14,5" Margin="8,0,0,0"
                                    Command="{Binding DeleteCommand}" />
                            <Button Content="替换" Padding="14,5" Margin="8,0,0,0"
                                    Command="{Binding ReplaceCommand}" />
                            <Button Content="添加文件" Padding="14,5" Margin="8,0,0,0"
                                    Command="{Binding AddFileCommand}" />
                            <Button Content="打开文件" Padding="14,5" Margin="8,0,0,0"
                                    Command="{Binding OpenFileCommand}" />
                            <Button Style="{StaticResource PrimaryButton}" Content="导出 zip" Padding="16,5"
                                    Margin="8,0,0,0" Command="{Binding ExportCommand}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource HintText}" Margin="0,8,0,0"
                                   Text="所有修改先写入工作副本（YRT\EditWork\），点「导出 zip」才会生成新资源包；原文件不会被改动。" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="控制台" Style="{StaticResource SectionTitle}" />
                        </Grid>
                        <ListBox ItemsSource="{Binding Logs}" Margin="0,8,0,0"
                                 Height="130" Style="{StaticResource ConsoleList}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- 拖拽视觉反馈覆盖层 -->
        <Border x:Name="DropOverlay" Grid.RowSpan="2" Visibility="Collapsed"
                IsHitTestVisible="False" Margin="10"
                BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="3"
                CornerRadius="14" Background="{DynamicResource PrimarySoftBrush}" Opacity="0.55">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="&#xE70F;" FontFamily="{StaticResource IconFont}" FontSize="42"
                           Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="松开以导入资源包" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryBrush}" Margin="0,8,0,0"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
