<UserControl x:Class="YRT.Pages.AnalyzePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:YRT.Pages"
             AllowDrop="True" Drop="Page_Drop" DragEnter="Page_DragEnter" DragLeave="Page_DragLeave">
    <UserControl.Resources>
        <FontFamily x:Key="IconFont">Segoe MDL2 Assets</FontFamily>
        <local:RatioToWidthConverter x:Key="RatioToWidth" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" MaxWidth="1100">
            <TextBlock Style="{StaticResource PageTitle}" Text="分析" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="导入资源包 zip / mcpack / 目录（可直接拖进本页），解析清单、目录结构，统计各类内容占用，并给出诊断；支持可视化编辑清单与导出 Markdown 报告。" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="1100">

                <!-- 导入区 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="包路径：" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Column="1" Text="{Binding SrcPath, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="6,0" />
                            <Button Grid.Column="2" Content="选 zip" Padding="14,6" Margin="0,0,6,0"
                                    Command="{Binding BrowseZipCommand}" />
                            <Button Grid.Column="3" Content="选目录" Padding="14,6"
                                    Command="{Binding BrowseDirCommand}" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Style="{StaticResource PrimaryButton}" Content="开始分析"
                                    Padding="22,8" Command="{Binding AnalyzeCommand}" />
                            <Button Content="打开所在位置" Margin="10,0,0,0" Padding="14,7"
                                    Command="{Binding OpenSourceCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 无结果时的功能预告（空状态） -->
                <Border Style="{StaticResource Card}"
                        Visibility="{Binding HasResult, Converter={StaticResource InverseBoolToVis}}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="8,4">
                        <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource IconFont}" FontSize="22"
                                   Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center" />
                        <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource HintText}"
                                   Text="把资源包 zip 或文件夹拖进本页即可开始分析：概要统计、分类占用、目录结构、健康诊断，还可编辑 pack.mcmeta。" />
                    </StackPanel>
                </Border>

                <!-- 结果区 -->
                <Border Style="{StaticResource Card}" Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
                    <StackPanel DataContext="{Binding Result}">

                        <!-- 概要统计磁贴 -->
                        <UniformGrid Columns="4">
                            <Border Background="{DynamicResource FieldBrush}" CornerRadius="10"
                                    Padding="14,10" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="文件总数" FontSize="11.5" Foreground="{DynamicResource SubTextBrush}" />
                                    <TextBlock Text="{Binding FileCount}" FontSize="20" FontWeight="Bold"
                                               Foreground="{DynamicResource TextBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource FieldBrush}" CornerRadius="10"
                                    Padding="14,10" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="总大小" FontSize="11.5" Foreground="{DynamicResource SubTextBrush}" />
                                    <TextBlock Text="{Binding TotalBytesText}" FontSize="20" FontWeight="Bold"
                                               Foreground="{DynamicResource TextBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource FieldBrush}" CornerRadius="10"
                                    Padding="14,10" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="格式版本" FontSize="11.5" Foreground="{DynamicResource SubTextBrush}" />
                                    <TextBlock Text="{Binding PackFormat}" FontSize="20" FontWeight="Bold"
                                               Foreground="{DynamicResource TextBrush}" Margin="0,2,0,0"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource FieldBrush}" CornerRadius="10" Padding="14,10">
                                <StackPanel>
                                    <TextBlock Text="包描述" FontSize="11.5" Foreground="{DynamicResource SubTextBrush}" />
                                    <TextBlock Text="{Binding Description}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}" Margin="0,5,0,0"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Description}" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                        <TextBlock Margin="0,10,0,0" Style="{StaticResource HintText}"
                                   Text="{Binding Source, StringFormat=来源：{0}}"
                                   TextTrimming="CharacterEllipsis" />

                        <!-- 清单编辑与报告导出 -->
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                                    DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <Button Content="编辑清单 (pack.mcmeta)" Padding="14,7"
                                    Command="{Binding EditMetaCommand}" />
                            <Button Content="导出分析报告" Padding="14,7" Margin="10,0,0,0"
                                    Command="{Binding ExportReportCommand}" />
                            <TextBlock Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="12,0,0,0"
                                       Text="清单编辑直接写回 zip / 目录；报告为 Markdown，含概要、统计、诊断与目录树。" />
                        </StackPanel>

                        <!-- 分类占用 -->
                        <TextBlock Style="{StaticResource SectionTitle}" Text="分类占用" Margin="0,16,0,0" />
                        <TextBlock Style="{StaticResource HintText}" Margin="0,2,0,0"
                                   Text="每个分类可单独导出：zip（可直接安装的资源包）或 MC data 文件夹（保持包内相对路径，可并入网易基岩 MC data 目录结构）。" />
                        <ItemsControl ItemsSource="{Binding Stats}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                   Style="{StaticResource FieldLabel}" FontSize="12.5"
                                                   TextTrimming="CharacterEllipsis" />
                                        <Border Grid.Column="1" Height="10" CornerRadius="5"
                                                Background="{DynamicResource TrackBrush}" Margin="8,0">
                                            <Border HorizontalAlignment="Left" Height="10" CornerRadius="5"
                                                    Background="{DynamicResource PrimaryBrush}"
                                                    Width="{Binding Ratio, Converter={StaticResource RatioToWidth}}" />
                                        </Border>
                                        <TextBlock Grid.Column="2" FontSize="11.5"
                                                   Foreground="{DynamicResource SubTextBrush}"
                                                   VerticalAlignment="Center" Margin="0,0,8,0">
                                            <Run Text="{Binding Count, Mode=OneWay}" />
                                            <Run Text="个 · " />
                                            <Run Text="{Binding BytesText, Mode=OneWay}" />
                                        </TextBlock>
                                        <StackPanel Grid.Column="3" Orientation="Horizontal">
                                            <Button Content="导出 zip" Padding="8,2" FontSize="11"
                                                    Command="{Binding DataContext.ExportZipCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding Name}" />
                                            <Button Content="导出 MC data" Padding="8,2" FontSize="11" Margin="6,0,0,0"
                                                    Command="{Binding DataContext.ExportDirCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding Name}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 目录结构 + 诊断 双列 -->
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource SectionTitle}" Text="目录结构（限 6 层）" />
                                <TreeView ItemsSource="{Binding TreeRoot.Children}" Height="230"
                                          Margin="0,6,0,0" FontSize="12.5"
                                          Background="{DynamicResource FieldBrush}"
                                          BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                                    <TreeView.ItemTemplate>
                                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}"
                                                           FontSize="12" Foreground="{DynamicResource PrimaryBrush}"
                                                           VerticalAlignment="Center" Margin="0,0,5,0"
                                                           Visibility="{Binding IsDir, Converter={StaticResource BoolToVis}}" />
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding BytesText}" FontSize="10.5"
                                                           Foreground="{DynamicResource SubTextBrush}"
                                                           VerticalAlignment="Center" Margin="6,0,0,0" />
                                            </StackPanel>
                                        </HierarchicalDataTemplate>
                                    </TreeView.ItemTemplate>
                                </TreeView>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource SectionTitle}" Text="诊断" />
                                <ListBox ItemsSource="{Binding Diagnostics}" Height="230"
                                         Margin="0,6,0,0" Background="{DynamicResource FieldBrush}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="1,1">
                                                <TextBlock FontFamily="{StaticResource IconFont}" FontSize="12"
                                                           VerticalAlignment="Center" Margin="0,0,6,0"
                                                           Text="{Binding LevelIcon}"
                                                           Foreground="{Binding LevelBrush}" />
                                                <TextBlock Text="{Binding Message}" FontSize="12"
                                                           TextWrapping="Wrap" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextBrush}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 控制台 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="控制台" Style="{StaticResource SectionTitle}" />
                            <Button Content="清空" HorizontalAlignment="Right" Padding="10,2"
                                    Command="{Binding ClearLogCommand}" />
                        </Grid>
                        <ListBox ItemsSource="{Binding Logs}" Margin="0,8,0,0"
                                 Height="130" Style="{StaticResource ConsoleList}" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- 拖拽视觉反馈覆盖层 -->
        <Border x:Name="DropOverlay" Grid.RowSpan="2" Visibility="Collapsed"
                IsHitTestVisible="False" Margin="10"
                BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="3"
                CornerRadius="14" Background="{DynamicResource PrimarySoftBrush}" Opacity="0.55">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="42"
                           Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="松开以分析资源包" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryBrush}" Margin="0,8,0,0"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
