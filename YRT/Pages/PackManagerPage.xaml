<UserControl x:Class="YRT.Pages.PackManagerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True" Drop="Page_Drop" DragEnter="Page_DragEnter" DragLeave="Page_DragLeave">
    <UserControl.Resources>
        <FontFamily x:Key="IconFont">Segoe MDL2 Assets</FontFamily>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" MaxWidth="1100">
            <TextBlock Style="{StaticResource PageTitle}" Text="资源包" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="把分散的资源包聚合管理：添加多个来源包（zip / mcpack / 目录，或直接拖入本页），按分类混搭（方块贴图取 A 包、音效取 B 包…），一键聚合导出完整 zip。" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,14,0,0" MaxWidth="1100">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ===== 左：来源包库 ===== -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource SectionTitle}" Text="来源包库" />

                    <!-- 列表 + 空状态提示 -->
                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <ListBox ItemsSource="{Binding Packs}"
                                 x:Name="PackList" Height="230" VerticalAlignment="Top">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="1,2">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Style="{StaticResource HintText}">
                                            <Run Text="{Binding FileCount, Mode=OneWay}" />
                                            <Run Text=" 个文件 · " />
                                            <Run Text="{Binding BytesText, Mode=OneWay}" />
                                            <Run Text="{Binding KindText, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Visibility="{Binding Packs.Count, Converter={StaticResource EmptyToVis}}"
                                    VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,-20,0,0"
                                    IsHitTestVisible="False">
                            <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="30"
                                       Foreground="{DynamicResource SubTextBrush}" Opacity="0.5"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="还没有来源包" Foreground="{DynamicResource SubTextBrush}"
                                       FontSize="12.5" Margin="0,6,0,0" HorizontalAlignment="Center" />
                            <TextBlock Text="把 zip 或文件夹拖进本页即可入库" Style="{StaticResource HintText}"
                                       FontSize="11.5" Margin="0,2,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="2" Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource PrimaryButton}" Content="添加 zip" Padding="14,6"
                                    Command="{Binding AddZipCommand}" />
                            <Button Content="添加目录" Margin="8,0,0,0" Padding="14,6"
                                    Command="{Binding AddDirCommand}" />
                            <Button Content="移除选中" Margin="8,0,0,0" Padding="14,6"
                                    Command="{Binding RemovePackCommand}"
                                    CommandParameter="{Binding SelectedItem, ElementName=PackList}" />
                            <Button Content="清空" Margin="8,0,0,0" Padding="12,6"
                                    Command="{Binding ClearPacksCommand}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="保存方案" Padding="14,6" Command="{Binding SavePlanCommand}" />
                            <Button Content="载入方案" Margin="8,0,0,0" Padding="14,6"
                                    Command="{Binding LoadPlanCommand}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource HintText}" Margin="0,6,0,0" FontSize="11.5"
                                   Text="方案 = 来源包库 + 各分类的来源选择，可存档或分享给别人一键复现混搭；包库会在下次启动时自动恢复。" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== 右：分类混搭 + 输出 ===== -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <Border Style="{StaticResource Card}" Margin="0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="按分类选取来源" />
                            <TextBlock Style="{StaticResource HintText}" Margin="0,2,0,0"
                                       Text="每个分类可独立选择来自哪个资源包；选「不包含」则该分类不进入合成包。" />
                            <ItemsControl ItemsSource="{Binding Choices}" Margin="0,10,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="170" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Category}"
                                                       Style="{StaticResource FieldLabel}" FontSize="12.5"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                            <ComboBox Grid.Column="1" ItemsSource="{Binding Options}"
                                                      SelectedIndex="{Binding SelectedIndex}" Margin="8,0"
                                                      MinWidth="150" />
                                            <TextBlock Grid.Column="2" Text="{Binding Summary}"
                                                       Style="{StaticResource HintText}" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- 空状态 -->
                            <StackPanel Visibility="{Binding Choices.Count, Converter={StaticResource EmptyToVis}}"
                                        Margin="0,14,0,4" IsHitTestVisible="False">
                                <TextBlock Style="{StaticResource HintText}" TextAlignment="Center"
                                           Text="左侧入库资源包后，这里会按分类列出可选来源。" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="聚合导出" />
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="输出目录：" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Column="1" Text="{Binding OutDir, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="6,0" />
                                <Button Grid.Column="2" Content="浏览" Padding="14,6"
                                        Command="{Binding BrowseOutCommand}" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Style="{StaticResource PrimaryButton}" Content="聚合导出 zip"
                                        Padding="22,8" Command="{Binding MergeCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 混搭建议 -->
                    <Border Style="{StaticResource Card}" Margin="0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="混搭建议" />
                            <TextBlock Style="{StaticResource HintText}" Margin="0,6,0,0" TextWrapping="Wrap" LineHeight="19"
                                       Text="1. 分类越少、来源越少，合成包兼容性越好；贴图建议整套取自同一包，避免风格割裂；&#10;2. 音效可单独取自另一包（如打击音效更带感的战斗包）；&#10;3. 「清单」分类决定 pack.mcmeta / pack.png 来源，不选则自动生成（pack_format 取所选包的最小值，兼容性最好）；&#10;4. 导出的 zip 与普通资源包完全一样，可直接用「安装」页部署，也可再丢回包库继续混搭。" />
                        </StackPanel>
                    </Border>

                    <!-- 控制台 -->
                    <Border Style="{StaticResource Card}" Margin="0">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="控制台" Style="{StaticResource SectionTitle}" />
                                <Button Content="清空" HorizontalAlignment="Right" Padding="10,2"
                                        Command="{Binding ClearLogCommand}" />
                            </Grid>
                            <ListBox ItemsSource="{Binding Logs}" Margin="0,8,0,0"
                                     Height="130" Style="{StaticResource ConsoleList}" />
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- 拖拽视觉反馈覆盖层 -->
        <Border x:Name="DropOverlay" Grid.RowSpan="2" Visibility="Collapsed"
                IsHitTestVisible="False" Margin="10"
                BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="3"
                CornerRadius="14" Background="{DynamicResource PrimarySoftBrush}" Opacity="0.55">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="42"
                           Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="松开以导入来源包" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryBrush}" Margin="0,8,0,0"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
