<UserControl x:Class="YRT.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:YRT.Pages">
    <UserControl.Resources>
        <local:HexToBrushConverter x:Key="HexToBrush" />
        <local:HexToForegroundConverter x:Key="HexToOnBrush" />
        <local:CategoryIconConverter x:Key="CategoryIcon" />
        <FontFamily x:Key="IconFont">Segoe MDL2 Assets</FontFamily>
    </UserControl.Resources>
    <Grid MaxWidth="1100">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,14">
            <TextBlock Style="{StaticResource PageTitle}" Text="设置" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="所有修改即时保存，重启后依然生效。" />
        </StackPanel>

        <!-- 左侧分类导航（带图标） -->
        <ListBox Grid.Row="1" Grid.Column="0" x:Name="CategoryList"
                 ItemsSource="{Binding Categories}"
                 SelectedIndex="{Binding SelectedCategory}" Margin="0,0,14,0"
                 Background="Transparent" BorderThickness="0" FontSize="14.5"
                 SelectionChanged="CategoryList_SelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="2,3">
                        <TextBlock Text="{Binding Converter={StaticResource CategoryIcon}}"
                                   FontFamily="{StaticResource IconFont}" FontSize="15"
                                   Margin="0,1,9,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- 右侧内容（按分类切换，带淡入动画） -->
        <ScrollViewer Grid.Row="1" Grid.Column="1" x:Name="ContentScroll"
                      VerticalScrollBarVisibility="Auto">
            <ScrollViewer.RenderTransform>
                <TranslateTransform x:Name="ContentShift" Y="0" />
            </ScrollViewer.RenderTransform>
            <StackPanel>

                <!-- ===== 外观 ===== -->
                <StackPanel Visibility="{Binding ShowAppearance, Converter={StaticResource BoolToVis}}">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="界面模式" />
                            <Border Style="{StaticResource SegTrack}" Margin="0,10,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource SegTabButton}" Content="浅色"
                                            Tag="{Binding IsLightMode}"
                                            Command="{Binding SetLightModeCommand}" />
                                    <Button Style="{StaticResource SegTabButton}" Content="深色"
                                            Tag="{Binding IsDarkMode}"
                                            Command="{Binding SetDarkModeCommand}" />
                                </StackPanel>
                            </Border>
                            <TextBlock Margin="0,8,0,0" Style="{StaticResource HintText}"
                                       Text="深色模式下界面背景与文字自动反色；主题色保持不变。" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="主题色" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Command="{Binding SetGreenThemeCommand}" Cursor="Hand"
                                        Margin="0,0,8,0" Padding="0" Background="#3D8B5F" BorderThickness="0"
                                        Width="46" Height="30">
                                    <TextBlock Text="森绿" Foreground="White" FontSize="11.5" />
                                </Button>
                                <Button Command="{Binding SetBlueThemeCommand}" Cursor="Hand"
                                        Margin="0,0,8,0" Padding="0" Background="#3D7EA8" BorderThickness="0"
                                        Width="46" Height="30">
                                    <TextBlock Text="天蓝" Foreground="White" FontSize="11.5" />
                                </Button>
                                <Button Command="{Binding SetPurpleThemeCommand}" Cursor="Hand"
                                        Margin="0,0,8,0" Padding="0" Background="#7B5EA7" BorderThickness="0"
                                        Width="46" Height="30">
                                    <TextBlock Text="暮紫" Foreground="White" FontSize="11.5" />
                                </Button>
                                <Button Command="{Binding SetAmberThemeCommand}" Cursor="Hand"
                                        Margin="0,0,8,0" Padding="0" Background="#B07D3A" BorderThickness="0"
                                        Width="46" Height="30">
                                    <TextBlock Text="琥珀" Foreground="White" FontSize="11.5" />
                                </Button>
                                <Button Command="{Binding SetCustomThemeCommand}" Cursor="Hand"
                                        Margin="0,0,0,0" Padding="0" BorderThickness="1"
                                        BorderBrush="{DynamicResource DividerBrush}" Width="46" Height="30"
                                        Background="{Binding CustomThemeColor, Converter={StaticResource HexToBrush}}">
                                    <TextBlock Text="自定义" Foreground="{Binding CustomThemeColor, Converter={StaticResource HexToOnBrush}}" FontSize="10.5" />
                                </Button>
                            </StackPanel>
                            <TextBlock Margin="0,8,0,0" Style="{StaticResource HintText}"
                                       Text="点击预设即时切换；「自定义」打开取色器任选颜色，主色的悬停/浅底色会自动派生。主色选浅色时，按钮和 Hero 卡上的文字会自动改为深色以保证可读。当前主题会记住并在下次启动时恢复。" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="程序" />
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="程序名称：" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Column="1"
                                         Text="{Binding AppName, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="30" />
                            </Grid>
                            <TextBlock Margin="0,8,0,0" Style="{StaticResource HintText}"
                                       Text="自定义左上角与窗口标题显示的程序名，输入即时生效；留空恢复默认「YHCT 的资源包工具箱」。" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===== 安装 ===== -->
                <StackPanel Visibility="{Binding ShowInstall, Converter={StaticResource BoolToVis}}">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="安装默认行为" />
                            <CheckBox Content="基岩一键安装前自动结束 Minecraft 进程" Margin="0,10,0,0"
                                      IsChecked="{Binding KillMc}" />
                            <CheckBox Content="安装完成后自动打开目标目录" Margin="0,8,0,0"
                                      IsChecked="{Binding OpenDirAfterInstall}" />
                            <CheckBox Content="基岩安装前自动备份目标槽位（存到数据目录 backup\）" Margin="0,8,0,0"
                                      IsChecked="{Binding BackupBeforeInstall}" />
                            <CheckBox Content="安装完成后弹出提示框" Margin="0,8,0,0"
                                      IsChecked="{Binding NotifyAfterInstall}" />
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Java 部署重名时：" Style="{StaticResource FieldLabel}" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding DeployConflictOptions}"
                                          SelectedIndex="{Binding DeployConflictIndex}" MinWidth="120"
                                          Margin="8,0,0,0" />
                                <TextBlock Grid.Column="2" Style="{StaticResource HintText}"
                                           VerticalAlignment="Center" Margin="12,0,0,0"
                                           Text="覆盖 = 直接替换旧包；自动重命名 = 保留旧包，新包加序号。" />
                            </Grid>
                            <TextBlock Margin="0,8,0,0" Style="{StaticResource HintText}"
                                       Text="影响「安装」页的一键安装 / 部署流程；安装页中的勾选框会与此同步。" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===== 生成 ===== -->
                <StackPanel Visibility="{Binding ShowGenerate, Converter={StaticResource BoolToVis}}">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="生成页默认值" />
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="默认输出目录：" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Column="1" Text="{Binding DefaultOutDir, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="6,0" />
                                <Button Grid.Column="2" Content="浏览" Padding="14,6"
                                        Command="{Binding BrowseDefaultOutCommand}" />
                            </Grid>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="包名模板：" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Column="1" Text="{Binding PackNameTemplate, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="6,0,0,0" />
                            </Grid>
                            <CheckBox Content="打包时目录缺 pack.mcmeta 则自动补齐（只写入 zip，不改源目录）"
                                      IsChecked="{Binding AutoMcmeta}" Margin="0,12,0,0" />
                            <TextBlock Margin="0,8,0,0" Style="{StaticResource HintText}"
                                       Text="模板中的 {name} 会被替换为所选材质目录的名称；留空则直接使用目录名。例如「{name}-HD」→ 目录 MyPack 生成 MyPack-HD.zip。自动补齐的清单描述为「包名 - by YHCT 的资源包工具箱」，格式版本 34（1.21），可在分析页用「编辑清单」随时修改。" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===== 扫描 ===== -->
                <StackPanel Visibility="{Binding ShowScan, Converter={StaticResource BoolToVis}}">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="扫描设置" />
                            <TextBlock Margin="0,10,0,0" Style="{StaticResource HintText}"
                                       Text="Java 版「扫描」按钮的查找范围：" />
                            <StackPanel Orientation="Vertical" Margin="0,8,0,0">
                                <RadioButton Content="只扫描 YRT 所在目录（推荐，速度快）" GroupName="ScanScope"
                                             IsChecked="{Binding ScanProgramDir}" />
                                <RadioButton Content="全盘扫描所有盘符" GroupName="ScanScope"
                                             IsChecked="{Binding ScanAllDrives}" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="递归扫描深度：" Style="{StaticResource FieldLabel}" />
                                <Slider Minimum="1" Maximum="8" Value="{Binding ScanDepth}"
                                        IsSnapToTickEnabled="True" TickFrequency="1"
                                        Width="180" Margin="10,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ScanDepth, StringFormat={}{0} 层}"
                                           Style="{StaticResource FieldLabel}" FontWeight="SemiBold" />
                            </StackPanel>
                            <TextBlock Margin="0,8,0,0" Style="{StaticResource HintText}"
                                       Text="深度越大能找到埋得越深的启动器目录，但扫描越慢；全盘 + 8 层可能耗时较久。" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===== 更新 ===== -->
                <StackPanel Visibility="{Binding ShowUpdate, Converter={StaticResource BoolToVis}}">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="检查更新" />
                            <TextBlock Margin="0,10,0,0" Style="{StaticResource HintText}"
                                       Text="{Binding CurrentVersion, StringFormat=当前版本：{0}}" />
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Content="检查更新" Padding="16,7" Cursor="Hand"
                                        Command="{Binding CheckUpdateCommand}" IsEnabled="{Binding UpdateNotBusy}" />
                                <Button Content="蓝奏云下载" Padding="16,7" Margin="8,0,0,0" Cursor="Hand"
                                        Command="{Binding OpenLanzouCommand}"
                                        Visibility="{Binding HasLanzou, Converter={StaticResource BoolToVis}}" />
                                <Button Content="GitHub 下载页" Padding="16,7" Margin="8,0,0,0" Cursor="Hand"
                                        Command="{Binding OpenReleaseCommand}"
                                        Visibility="{Binding ShowRelease, Converter={StaticResource BoolToVis}}" />
                                <Button Content="更新详情" Padding="16,7" Margin="8,0,0,0" Cursor="Hand"
                                        Command="{Binding ShowUpdateDialogCommand}"
                                        Visibility="{Binding ShowRelease, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                            <TextBlock Margin="0,8,0,0" Style="{StaticResource HintText}"
                                       Text="蓝奏云打开后如需提取码，程序已自动把提取码复制到剪贴板，粘贴即可。" />
                            <TextBlock Margin="0,10,0,0" Text="{Binding UpdateStatus}" TextWrapping="Wrap"
                                       Style="{StaticResource HintText}" />

                            <!-- 新版本信息卡 -->
                            <Border Margin="0,12,0,0" Padding="14,12" CornerRadius="10"
                                    Background="{DynamicResource PrimarySoftBrush}"
                                    Visibility="{Binding HasNewVersion, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                                   Foreground="{DynamicResource PrimaryBrush}"
                                                   VerticalAlignment="Center" Margin="0,0,7,0" />
                                        <TextBlock FontWeight="Bold" FontSize="14"
                                                   Foreground="{DynamicResource TextBrush}">
                                            <Run Text="{Binding ReleaseTitle, Mode=OneWay}" />
                                            <Run Text="{Binding ReleaseTag, Mode=OneWay}" Foreground="{DynamicResource PrimaryBrush}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Text="{Binding ReleaseDate}" Style="{StaticResource HintText}" Margin="0,3,0,0" />
                                    <TextBlock Text="{Binding ReleaseNotes}" TextWrapping="Wrap" LineHeight="19"
                                               Margin="0,6,0,0" Foreground="{DynamicResource SubTextBrush}" FontSize="12.5" />
                                </StackPanel>
                            </Border>

                            <CheckBox Content="启动时自动检查更新" IsChecked="{Binding CheckUpdateOnStartup}"
                                      Margin="0,12,0,0" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="公告" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="刷新公告" Padding="16,7" Cursor="Hand"
                                        Command="{Binding GetAnnouncementCommand}" IsEnabled="{Binding AnnounceNotBusy}" />
                                <TextBlock Text="公告由官方内置源自动获取，无需配置。" Style="{StaticResource HintText}"
                                           VerticalAlignment="Center" Margin="10,0,0,0" />
                            </StackPanel>
                            <TextBlock Margin="0,10,0,0" Text="{Binding AnnounceStatus}" TextWrapping="Wrap"
                                       Style="{StaticResource HintText}" />

                            <!-- 公告内容卡 -->
                            <Border Margin="0,12,0,0" Padding="14,12" CornerRadius="10"
                                    Background="{DynamicResource PrimarySoftBrush}"
                                    Visibility="{Binding ShowAnnouncement, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE900;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                                   Foreground="{DynamicResource PrimaryBrush}"
                                                   VerticalAlignment="Center" Margin="0,0,7,0" />
                                        <TextBlock Text="{Binding AnnounceTitle}" FontWeight="Bold" FontSize="14"
                                                   Foreground="{DynamicResource TextBrush}" />
                                        <TextBlock Text="{Binding AnnounceDate}" Style="{StaticResource HintText}"
                                                   Margin="10,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding AnnounceContent}" TextWrapping="Wrap" LineHeight="19"
                                               Margin="0,7,0,0" Foreground="{DynamicResource SubTextBrush}" FontSize="12.5" />
                                </StackPanel>
                            </Border>

                            <TextBlock Margin="0,10,0,0" Style="{StaticResource HintText}"
                                       Text="公告内容由官方内置源下发（不公开、不可篡改），启动时自动获取并显示在主页顶部；网络不通时会显示内置提示公告。" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===== 关于 ===== -->
                <StackPanel Visibility="{Binding ShowAbout, Converter={StaticResource BoolToVis}}">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="关于" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Border Width="44" Height="44" CornerRadius="10"
                                        BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                                    <Image Source="pack://application:,,,/Resources/logo.png" Stretch="Uniform" Margin="2" />
                                </Border>
                                <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                                    <TextBlock FontWeight="Bold" FontSize="15"
                                               Foreground="{DynamicResource TextBrush}">
                                        <Run Text="{Binding AppNameDisplay, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding CurrentVersion, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Text="YiHangCT 出品 · Generate / Mix / Analyze / Install"
                                               Style="{StaticResource HintText}" Margin="0,2,0,0" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" LineHeight="20"
                                       Style="{StaticResource HintText}"
                                       Text="这是一款面向 Minecraft 玩家的资源包一站式工具：把零散的材质目录打包成可安装的 zip；把多个资源包按分类混搭（方块贴图取 A 包、音效取 B 包）；分析任意资源包的结构、占用与健康度；并支持 Java 版与网易基岩版一键部署。本项目使用 C# / WPF (.NET 8) 编写，打包逻辑参考自同作者的 RustPackGen，界面交互致敬 PCL2。" />
                        </StackPanel>
                    </Border>

                    <!-- ===== 作者简介 ===== -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="作者简介" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Border Width="56" Height="56" CornerRadius="14"
                                        BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
                                        Background="{DynamicResource CardBrush}">
                                    <Image Source="pack://application:,,,/Resources/author.png" Stretch="Uniform" Margin="3" />
                                </Border>
                                <StackPanel VerticalAlignment="Center" Margin="14,0,0,0">
                                    <TextBlock Text="YiHangCT（YHCT）" FontWeight="Bold" FontSize="15"
                                               Foreground="{DynamicResource TextBrush}" />
                                    <TextBlock Text="Minecraft 资源包作者 / 独立开发者" Style="{StaticResource HintText}" Margin="0,2,0,0" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" LineHeight="20"
                                       Style="{StaticResource HintText}"
                                       Text="YiHangCT 是一名热爱 Minecraft 的玩家与创作者，长期制作资源包与实用工具，代表作有 RustPackGen 与本工具箱 YHCT 的资源包工具箱。平时喜欢研究材质整理、音效混搭与包结构规范，希望通过把琐碎的打包、分析、安装流程自动化，让更多玩家轻松用上自己喜欢的资源包。" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="友情链接" />
                            <TextBlock Margin="0,10,0,4" Style="{StaticResource HintText}"
                                       Text="以下是与资源包制作、安装相关的常用站点（点击在浏览器打开）：" />
                            <TextBlock Margin="0,2,0,0" FontSize="13">
                                <Hyperlink Hyperlink.CommandParameter="https://www.minecraft.net" Click="FriendLink_Click"><Run Text="Minecraft 官网" /></Hyperlink>
                                <Run Text="    " /><Hyperlink Hyperlink.CommandParameter="https://minecraft.fandom.com/zh/wiki/Minecraft_Wiki" Click="FriendLink_Click"><Run Text="中文 Minecraft Wiki" /></Hyperlink>
                            </TextBlock>
                            <TextBlock Margin="0,6,0,0" FontSize="13">
                                <Hyperlink Hyperlink.CommandParameter="https://www.curseforge.com/minecraft/search?search=resource%20packs" Click="FriendLink_Click"><Run Text="CurseForge" /></Hyperlink>
                                <Run Text="    " /><Hyperlink Hyperlink.CommandParameter="https://modrinth.com/resourcepacks" Click="FriendLink_Click"><Run Text="Modrinth" /></Hyperlink>
                                <Run Text="    " /><Hyperlink Hyperlink.CommandParameter="https://mc.163.com" Click="FriendLink_Click"><Run Text="网易我的世界" /></Hyperlink>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="重置" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="恢复全部默认设置" Padding="16,7" Cursor="Hand"
                                        Command="{Binding ResetCommand}" />
                            </StackPanel>
                            <TextBlock Margin="0,8,0,0" Style="{StaticResource HintText}"
                                       Text="把所有分类下的设置恢复为默认值（含主题色），立即生效。" />
                        </StackPanel>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
