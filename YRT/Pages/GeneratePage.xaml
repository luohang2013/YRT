<UserControl x:Class="YRT.Pages.GeneratePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True" Drop="Page_Drop" DragEnter="Page_DragEnter" DragLeave="Page_DragLeave">
    <UserControl.Resources>
        <FontFamily x:Key="IconFont">Segoe MDL2 Assets</FontFamily>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" MaxWidth="1100">
            <TextBlock Style="{StaticResource PageTitle}" Text="生成" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="打包我制作的材质目录为 Minecraft 可识别的 zip（条目路径强制正斜杠）；也可以解包现有 zip 进行编辑。支持把目录 / zip 直接拖进本页。" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="1100">

                <!-- ============ 主区块：打包我制作的材质 ============ -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" FontSize="15.5" Text="打包我制作的材质" />
                        <TextBlock Style="{StaticResource HintText}" Margin="0,2,0,0"
                                   Text="选择材质目录，一键打包为可安装的 zip 资源包。" />

                        <!-- 源目录 -->
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="材质目录：" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Column="1" Text="{Binding SrcDir, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="6,0" IsReadOnly="True" />
                            <Button Grid.Column="2" Content="浏览" Padding="14,6"
                                    Command="{Binding BrowseSrcCommand}" />
                        </Grid>

                        <!-- 包名 / 输出目录 -->
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="包名称：" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Column="1" Text="{Binding PackName, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="6,0,14,0" />
                            <TextBlock Grid.Column="2" Text="输出目录：" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Column="3" Text="{Binding OutDir, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="6,0,8,0" />
                            <Button Grid.Column="4" Content="浏览" Padding="14,6"
                                    Command="{Binding BrowseOutCommand}" />
                        </Grid>

                        <!-- 简介临时修改 -->
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="包简介：" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Column="1" Text="{Binding OverrideDescription, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="6,0" Height="46" TextWrapping="Wrap"
                                     VerticalContentAlignment="Top"
                                     ToolTip="仅写入本次生成的 zip 内 pack.mcmeta，不改动源目录" />
                        </Grid>

                        <!-- 图标临时修改 -->
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="包图标：" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Column="1" Text="{Binding IconPath, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="6,0" FontSize="11.5"
                                     ToolTip="仅写入本次生成的 zip 内 pack.png，不改动源目录；留空沿用源目录自带图标" />
                            <Button Grid.Column="2" Content="浏览" Padding="14,6"
                                    Command="{Binding BrowseIconCommand}" />
                        </Grid>

                        <!-- 主操作 -->
                        <CheckBox Content="目录缺 pack.mcmeta 时自动补齐（不改源目录，仅写入 zip）"
                                  IsChecked="{Binding AutoMcmeta}" Margin="0,14,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Style="{StaticResource PrimaryButton}" Content="打包为 zip"
                                    Padding="26,10" FontSize="14.5"
                                    Command="{Binding PackCommand}" />
                            <Button Content="打开输出目录" Margin="12,0,0,0" Padding="16,8"
                                    Command="{Binding OpenOutDirCommand}" />
                        </StackPanel>
                        <TextBlock Margin="0,10,0,0" Style="{StaticResource HintText}"
                                   Text="点「打包为 zip」后会弹出确认窗口，再次核对并允许临时修改名称 / 简介 / 图标。" />
                        <TextBlock Margin="0,10,0,0" Style="{StaticResource HintText}"
                                   Text="{Binding LastOut, StringFormat=上次输出：{0}}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <!-- ============ 次区块：解包现有 zip ============ -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="解包现有 zip" />
                                <TextBlock Style="{StaticResource HintText}" Margin="0,2,0,0"
                                           Text="把已有资源包 zip 解开为目录，方便编辑后重新打包。" />
                            </StackPanel>
                            <Button Content="选择 zip 并解包" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Padding="14,6" Command="{Binding UnpackCommand}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ============ 批量操作 ============ -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="批量打包 / 解包" />
                        <TextBlock Style="{StaticResource HintText}" Margin="0,2,0,0"
                                   Text="把多个材质目录或资源包加入同一列表，统一处理到上方输出目录。" />

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="添加目录" Padding="12,6"
                                    Command="{Binding AddBatchDirCommand}" />
                            <Button Content="添加 zip / mcpack" Margin="8,0,0,0" Padding="12,6"
                                    Command="{Binding AddBatchZipCommand}" />
                            <Button Content="移除选中" Margin="8,0,0,0" Padding="12,6"
                                    Command="{Binding RemoveBatchSourceCommand}"
                                    CommandParameter="{Binding SelectedItem, ElementName=BatchSourceList}" />
                            <Button Content="清空列表" Margin="8,0,0,0" Padding="12,6"
                                    Command="{Binding ClearBatchSourcesCommand}" />
                        </StackPanel>

                        <ListBox x:Name="BatchSourceList" ItemsSource="{Binding BatchSources}"
                                 Height="140" Margin="0,10,0,0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" ToolTip="{Binding}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Style="{StaticResource PrimaryButton}" Content="批量打包"
                                    Padding="22,8" Command="{Binding BatchPackCommand}" />
                            <Button Content="批量解包" Margin="10,0,0,0" Padding="22,8"
                                    Command="{Binding BatchUnpackCommand}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource HintText}" Margin="0,8,0,0"
                                   Text="批量打包：目录生成同名 zip，已有压缩档复制到输出目录；批量解包：每个压缩档生成同名子目录。单项失败不会影响其余项目。" />
                    </StackPanel>
                </Border>

                <!-- 打包说明 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="打包说明" />
                        <TextBlock Style="{StaticResource HintText}" Margin="0,6,0,0" TextWrapping="Wrap" LineHeight="19"
                                   Text="1. 打包会遍历所选目录下所有文件，zip 内条目路径一律转为正斜杠，Minecraft 各版本均可识别；&#10;2. 目录里可以放 pack.mcmeta / pack.png，打包时会原样带上；没有也没关系，安装页部署时可自动补齐；&#10;3. 解包后的目录建议保留原有结构（assets/minecraft/...），编辑完直接重新打包即可；&#10;4. 输出目录可在「设置 → 生成」里设为常用位置，包名模板支持 {name} 占位符。" />
                    </StackPanel>
                </Border>

                <!-- 控制台 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="控制台" Style="{StaticResource SectionTitle}" />
                            <Button Content="清空" HorizontalAlignment="Right" Padding="10,2"
                                    Command="{Binding ClearLogCommand}" />
                        </Grid>
                        <ListBox ItemsSource="{Binding Logs}" Margin="0,8,0,0"
                                 Height="170" Style="{StaticResource ConsoleList}" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- 拖拽视觉反馈覆盖层 -->
        <Border x:Name="DropOverlay" Grid.RowSpan="2" Visibility="Collapsed"
                IsHitTestVisible="False" Margin="10"
                BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="3"
                CornerRadius="14" Background="{DynamicResource PrimarySoftBrush}" Opacity="0.55">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="42"
                           Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="松开以导入材质目录" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryBrush}" Margin="0,8,0,0"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
