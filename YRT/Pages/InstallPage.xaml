<UserControl x:Class="YRT.Pages.InstallPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True" Drop="Page_Drop" DragEnter="Page_DragEnter" DragLeave="Page_DragLeave">
    <UserControl.Resources>
        <FontFamily x:Key="IconFont">Segoe MDL2 Assets</FontFamily>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" MaxWidth="1100">
            <TextBlock Style="{StaticResource PageTitle}" Text="安装" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Java 版：扫描启动器目录（识别版本隔离 / Prism / Modrinth / CurseForge 实例），一键部署或改 options.txt 启用关闭，资源包 zip 可直接拖进本页部署；网易基岩版：支持 mcpack / zip 压缩档或目录，基础包整体替换编号槽位 + 材质包合并。" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="1100">

                <!-- ============ 分段标签：Java / 网易基岩 ============ -->
                <Border Style="{StaticResource SegTrack}" Margin="0,0,0,14">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Java 版" Command="{Binding SelectJavaTabCommand}"
                                Tag="{Binding JavaTabSelected}" Style="{StaticResource SegTabButton}" />
                        <Button Content="网易基岩版" Command="{Binding SelectBedrockTabCommand}"
                                Tag="{Binding BedrockTabSelected}" Style="{StaticResource SegTabButton}" />
                    </StackPanel>
                </Border>

                <!-- ============ Java 版 ============ -->
                <Border>
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Card}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding JavaTabSelected}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <Grid>
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="启动器目录" />
                                <TextBlock Style="{StaticResource HintText}" Margin="0,2,0,0"
                                           Text="默认只扫描 YRT 所在目录及子目录；如需扫描全盘请在「设置 → 扫描设置」中切换。" />
                            </StackPanel>
                            <Button Content="扫描" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Padding="16,6" Command="{Binding ScanJavaCommand}" />
                        </Grid>

                        <!-- 双列：左目录 / 右 zip，压缩纵向占用 -->
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="resourcepacks 目录" Style="{StaticResource SectionTitle}"
                                           FontSize="13" />
                                <ListBox ItemsSource="{Binding JavaDirs}" SelectedItem="{Binding SelectedJavaDir}"
                                         Margin="0,6,0,0" Height="148">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="2,1">
                                                <TextBlock Text="{Binding Dir}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Style="{StaticResource HintText}">
                                                    <Run Text="{Binding Source, Mode=OneWay}" />
                                                    <Run Text=" · " />
                                                    <Run Text="{Binding Zips.Count, Mode=OneWay}" />
                                                    <Run Text=" 个 zip" />
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Visibility="{Binding JavaDirs.Count, Converter={StaticResource EmptyToVis}}"
                                           Style="{StaticResource HintText}" Margin="0,4,0,0"
                                           Text="尚未扫描：点击右上方「扫描」开始查找启动器目录。" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="资源包列表（选中目录内的 zip）" Style="{StaticResource SectionTitle}"
                                           FontSize="13" />
                                <ListBox ItemsSource="{Binding Zips}" SelectedItem="{Binding SelectedZip}"
                                         Margin="0,6,0,0" Height="148" />
                                <TextBlock Visibility="{Binding Zips.Count, Converter={StaticResource EmptyToVis}}"
                                           Style="{StaticResource HintText}" Margin="0,4,0,0"
                                           Text="选中左侧目录后显示其中的 zip；也可直接把 zip 拖进本页部署。" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Style="{StaticResource PrimaryButton}" Content="部署 zip 到此目录"
                                    Padding="16,7" Command="{Binding DeployJavaCommand}" />
                            <Button Content="启用" Margin="10,0,0,0" Padding="16,7"
                                    Command="{Binding EnablePackCommand}" />
                            <Button Content="关闭" Margin="10,0,0,0" Padding="16,7"
                                    Command="{Binding DisablePackCommand}" />
                        </StackPanel>
                        <TextBlock Margin="0,10,0,0" Style="{StaticResource HintText}"
                                   Text="启用/关闭通过改写游戏根目录 options.txt 的 resourcePacks 列表实现，执行前会检测 Minecraft 进程，游戏运行中时拒绝改写。" />

                        <!-- options.txt 可视化编辑（选中目录后显示） -->
                        <Border Margin="0,14,0,0" CornerRadius="10"
                                Background="{DynamicResource FieldBrush}"
                                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
                                Padding="16,14"
                                Visibility="{Binding OptionsVisible, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Style="{StaticResource SectionTitle}" FontSize="14.5"
                                               Text="options.txt 游戏设置" />
                                    <Button Content="重新读取" HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Padding="10,3" FontSize="12"
                                            Command="{Binding ReloadOptionsCommand}" />
                                </Grid>

                                <!-- 找到 options.txt：编辑项 -->
                                <StackPanel Margin="0,10,0,0"
                                            Visibility="{Binding OptionsFound, Converter={StaticResource BoolToVis}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="亮度 gamma" Style="{StaticResource FieldLabel}" FontSize="13" />
                                        <Slider Grid.Column="1" Minimum="0" Maximum="100"
                                                Value="{Binding GammaPercent}" VerticalAlignment="Center"
                                                Margin="0,0,10,0" />
                                        <TextBlock Grid.Column="2" Style="{StaticResource FieldLabel}" FontSize="13"
                                                   Width="52" TextAlignment="Right"
                                                   Text="{Binding GammaPercent, StringFormat={}{0:0}%}" />
                                    </Grid>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="界面缩放" Style="{StaticResource FieldLabel}" FontSize="13" />
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding GuiScaleOptions}"
                                                  SelectedIndex="{Binding GuiScaleIndex}" HorizontalAlignment="Left"
                                                  MinWidth="130" Margin="0,0,10,0" />
                                        <TextBlock Grid.Column="2" Text="云朵" Style="{StaticResource FieldLabel}" FontSize="13" />
                                        <ComboBox Grid.Column="3" ItemsSource="{Binding CloudsOptions}"
                                                  SelectedIndex="{Binding CloudsIndex}" MinWidth="90" Margin="10,0,0,0" />
                                    </Grid>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="渲染距离" Style="{StaticResource FieldLabel}" FontSize="13" />
                                        <TextBox Grid.Column="1" Text="{Binding RenderDistance, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="64" Margin="0,0,4,0" />
                                        <TextBlock Grid.Column="2" Text="区块" Style="{StaticResource HintText}"
                                                   VerticalAlignment="Center" Margin="0,0,18,0" />
                                        <CheckBox Grid.Column="3" Content="视角摇晃" IsChecked="{Binding ViewBobbing}" />
                                        <CheckBox Grid.Column="4" Content="平滑光照" IsChecked="{Binding SmoothLighting}"
                                                  Margin="16,0,0,0" />
                                        <CheckBox Grid.Column="5" Content="全屏启动" IsChecked="{Binding Fullscreen}"
                                                  Margin="16,0,0,0" />
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                        <Button Style="{StaticResource PrimaryButton}" Content="保存 options.txt"
                                                Padding="16,7" Command="{Binding SaveOptionsCommand}" />
                                        <TextBlock Style="{StaticResource HintText}" VerticalAlignment="Center"
                                                   Margin="12,0,0,0"
                                                   Text="保存前自动备份 options.txt.bak；仅列出常用项，其余设置保持不变；需先关闭游戏。" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- 未找到 options.txt 的提示 -->
                                <TextBlock Margin="0,8,0,0" Style="{StaticResource HintText}"
                                           Visibility="{Binding OptionsFound, Converter={StaticResource InverseBoolToVis}}"
                                           Text="该游戏根目录下未找到 options.txt（版本隔离的实例可能在 versions\&lt;版本&gt; 下，选中对应 resourcepacks 目录即可读取）。" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ============ 网易基岩版 ============ -->
                <Border>
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Card}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding BedrockTabSelected}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <Grid>
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="一键安装" />
                                <TextBlock Style="{StaticResource HintText}" Margin="0,2,0,0"
                                           Text="移植网易「全局材质包安装器」：基础包整体替换编号槽位 0/1/2，材质包合并（保留游戏 manifest 等清单文件）。" />
                            </StackPanel>
                            <Button Content="扫描" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Padding="16,6" Command="{Binding ScanBedrockCommand}" />
                        </Grid>
                        <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                   Style="{StaticResource HintText}"
                                   Text="{Binding BedrockInfo, StringFormat=状态：{0}}" />

                        <!-- 基础包 -->
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="基础包：" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Column="1" Text="{Binding BaseDir, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="6,0" IsReadOnly="True" />
                            <Button Grid.Column="2" Content="选择目录" Padding="14,6" Margin="0,0,6,0"
                                    Command="{Binding BrowseBaseCommand}" />
                            <Button Grid.Column="3" Content="选 mcpack" Padding="14,6"
                                    Command="{Binding BrowseBaseFileCommand}" />
                        </Grid>

                        <!-- 材质包列表 -->
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="材质包（合并进槽位）" Style="{StaticResource SectionTitle}"
                                           FontSize="13" />
                                <ListBox ItemsSource="{Binding Commons}" Height="90" Margin="0,6,0,0" />
                                <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,0"
                                           Text="支持目录，也支持直接选 .mcpack / .zip 文件（安装时自动解压，不改原文件）；拖拽到本页同样可用。" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="10,22,0,0">
                                <Button Content="添加目录" Padding="12,5" Command="{Binding AddCommonCommand}" />
                                <Button Content="添加 mcpack" Padding="12,5" Margin="0,6,0,0"
                                        Command="{Binding AddCommonFileCommand}" />
                                <Button Content="移除" Padding="12,5" Margin="0,6,0,0"
                                        Command="{Binding RemoveCommonCommand}"
                                        CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                                <Button Content="清空" Padding="12,5" Margin="0,6,0,0"
                                        Command="{Binding ClearCommonsCommand}" />
                            </StackPanel>
                        </Grid>

                        <!-- 槽位与选项 -->
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <TextBlock Text="目标槽位：" Style="{StaticResource FieldLabel}" />
                            <ItemsControl ItemsSource="{Binding Slots}" VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}"
                                                  Margin="6,0,0,0" VerticalContentAlignment="Center" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <CheckBox Content="安装前结束 MC 进程" IsChecked="{Binding KillMc}"
                                      Margin="24,0,0,0" VerticalContentAlignment="Center" />
                            <Button Content="检测 MC 进程" Margin="14,0,0,0" Padding="12,5"
                                    Command="{Binding CheckMcCommand}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Style="{StaticResource PrimaryButton}" Content="一键安装" Padding="24,9"
                                    FontSize="14.5" Command="{Binding ApplyCommand}" />
                        </StackPanel>
                        <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SuccessBrush}" Text="{Binding LastApply}" />
                    </StackPanel>
                </Border>

                <!-- 常见问题 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="常见问题" />
                        <TextBlock Style="{StaticResource HintText}" Margin="0,6,0,0" TextWrapping="Wrap" LineHeight="19"
                                   Text="Q：游戏里看不到装好的包？&#10;A：Java 版确认已在「选项 → 资源包」里启用；基岩版确认材质包开关已打开。&#10;&#10;Q：扫描不到启动器目录？&#10;A：默认只扫 YRT 所在目录，可在「设置 → 扫描」切到全盘并调大深度。&#10;&#10;Q：启用/关闭提示进程占用？&#10;A：Minecraft 正在运行时会拒绝改写配置，先退出游戏再试；基岩版可勾选「安装前结束 MC 进程」。&#10;&#10;Q：安装会不会覆盖我的存档？&#10;A：不会。安装只写入 resource_packs 目录与材质配置，不触碰存档与设置数据。" />
                    </StackPanel>
                </Border>

                <!-- 控制台 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="控制台" Style="{StaticResource SectionTitle}" />
                            <Button Content="清空" HorizontalAlignment="Right" Padding="10,2"
                                    Command="{Binding ClearLogCommand}" />
                        </Grid>
                        <ListBox ItemsSource="{Binding Logs}" Margin="0,8,0,0"
                                 Height="170" Style="{StaticResource ConsoleList}" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- 拖拽视觉反馈覆盖层 -->
        <Border x:Name="DropOverlay" Grid.RowSpan="2" Visibility="Collapsed"
                IsHitTestVisible="False" Margin="10"
                BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="3"
                CornerRadius="14" Background="{DynamicResource PrimarySoftBrush}" Opacity="0.55">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="42"
                           Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center" />
                <TextBlock x:Name="DropOverlayText" Text="松开以导入" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryBrush}" Margin="0,8,0,0"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
