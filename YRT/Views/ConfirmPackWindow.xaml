<Window x:Class="YRT.Views.ConfirmPackWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource BackgroundBrush}" WindowStyle="ToolWindow">
    <StackPanel Margin="20,16">
        <TextBlock Text="确认打包信息" FontSize="15" FontWeight="Bold"
                   Foreground="{DynamicResource TextBrush}" />
        <TextBlock Text="以下内容将写入本次生成的 zip（仅影响压缩包，不改动源目录），可直接修改后确认。"
                   Style="{StaticResource HintText}" Margin="0,5,0,0" TextWrapping="Wrap" />

        <TextBlock Text="包名称（同时作为文件名）" Style="{StaticResource FieldLabel}" Margin="0,12,0,0" />
        <TextBox Text="{Binding PackName, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Text="资源包简介" Style="{StaticResource FieldLabel}" Margin="0,10,0,0" />
        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                 Height="52" AcceptsReturn="False" TextWrapping="Wrap"
                 VerticalContentAlignment="Top" />

        <TextBlock Text="包图标（pack.png）" Style="{StaticResource FieldLabel}" Margin="0,10,0,0" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="8" Margin="0,0,8,0"
                    Background="{DynamicResource TrackBrush}" BorderThickness="1"
                    BorderBrush="{DynamicResource DividerBrush}">
                <Image Source="{Binding IconPreview}" Stretch="Uniform" Margin="3" />
            </Border>
            <TextBox Grid.Column="1" Text="{Binding IconPath, UpdateSourceTrigger=PropertyChanged}"
                     VerticalAlignment="Center" FontSize="11.5" />
            <Button Grid.Column="2" Content="浏览" Padding="12,6" Margin="8,0,0,0"
                    VerticalAlignment="Center" Click="BrowseIcon_Click" />
        </Grid>
        <TextBlock Style="{StaticResource HintText}" Margin="0,6,0,0"
                   Text="留空 = 沿用源目录自带 pack.png；填写 = 覆盖 zip 内图标。" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,2">
            <Button Content="取消" Padding="16,7" IsCancel="True" />
            <Button Content="确认生成" Style="{StaticResource PrimaryButton}" Padding="16,7"
                    Margin="10,0,0,0" IsDefault="True" Click="Ok_Click" />
        </StackPanel>
    </StackPanel>
</Window>
