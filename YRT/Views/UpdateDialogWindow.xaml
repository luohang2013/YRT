<Window x:Class="YRT.Views.UpdateDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="发现新版本" Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="{DynamicResource BackgroundBrush}"
        WindowStyle="ToolWindow">
    <StackPanel Margin="22,18">

        <!-- 标题行 -->
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                       Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" />
            <TextBlock Text="发现新版本" FontSize="18" FontWeight="Bold"
                       Foreground="{DynamicResource TextBrush}" Margin="9,0,0,0" VerticalAlignment="Center" />
            <Border Background="{DynamicResource PrimaryBrush}" CornerRadius="6"
                    Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Tag}" Foreground="{DynamicResource OnPrimaryBrush}"
                           FontSize="12" FontWeight="SemiBold" />
            </Border>
        </StackPanel>
        <TextBlock Text="{Binding Headline}" Style="{StaticResource HintText}" Margin="0,6,0,0" />

        <!-- 更新日志 -->
        <TextBlock Text="更新日志：" Style="{StaticResource FieldLabel}" Margin="0,14,0,0" />
        <Border Background="{DynamicResource ConsoleBrush}" CornerRadius="10" Padding="12,10"
                Margin="0,6,0,0" MaxHeight="190">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock Text="{Binding Notes}" TextWrapping="Wrap" LineHeight="19"
                           FontSize="12.5" Foreground="{DynamicResource TextBrush}" />
            </ScrollViewer>
        </Border>

        <!-- 自动下载进度（下载时显示） -->
        <StackPanel Margin="0,12,0,0"
                    Visibility="{Binding Downloading, Converter={StaticResource BoolToVis}}">
            <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress}"
                        Height="8" Foreground="{DynamicResource PrimaryBrush}" />
            <TextBlock Text="{Binding ProgressText}" Style="{StaticResource HintText}" Margin="0,6,0,0" />
        </StackPanel>

        <!-- 按钮 -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,2">
            <Button Content="稍后再说" Padding="16,7" IsCancel="True" />
            <Button Content="手动下载更新" Style="{StaticResource PrimaryButton}" Padding="16,7"
                    Margin="10,0,0,0" Command="{Binding ManualCommand}" />
            <Button Content="自动下载更新" Padding="16,7" Margin="10,0,0,0"
                    Command="{Binding AutoCommand}"
                    IsEnabled="{Binding AutoReady}" ToolTip="从 GitHub 直连下载安装包（可能较慢）" />
        </StackPanel>

        <!-- 提示 -->
        <TextBlock Style="{StaticResource HintText}" Margin="0,8,0,0" TextWrapping="Wrap"
                   Text="手动下载：打开蓝奏云发布页，提取码已自动复制，粘贴即可（推荐，速度较快）。自动下载：从 GitHub 直连下载，速度可能较慢，请耐心等待；下载完成后关闭程序自动完成安装并重启。" />
        <TextBlock Text="{Binding ErrorText}" Foreground="{DynamicResource DangerBrush}"
                   Style="{StaticResource HintText}" Margin="0,6,0,0" TextWrapping="Wrap"
                   Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
    </StackPanel>
</Window>
