<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      主题系统：换主题 = 在运行时替换 PrimaryColor / PrimaryHoverColor / PrimarySoftColor，
      引用它们的笔刷通过 DynamicResource 联动刷新（见 Theme/ThemeManager.cs）。
    -->

    <Color x:Key="PrimaryColor">#3D8B5F</Color>
    <Color x:Key="PrimaryHoverColor">#4FA371</Color>
    <Color x:Key="PrimaryPressedColor">#347750</Color>
    <!-- 主色浅底（选中项底色等），随主题联动 -->
    <Color x:Key="PrimarySoftColor">#E4EFE9</Color>
    <!-- 主色上的前景/覆盖层：按主色亮度自动黑或白（ThemeManager 运行时切换） -->
    <Color x:Key="OnPrimaryColor">#FFFFFFFF</Color>
    <Color x:Key="OnPrimarySubColor">#D8FFFFFF</Color>
    <Color x:Key="OverlaySoftColor">#22FFFFFF</Color>
    <Color x:Key="OverlayHoverColor">#38FFFFFF</Color>
    <Color x:Key="OverlayPressedColor">#12FFFFFF</Color>

    <Color x:Key="BackgroundColor">#F4F4F1</Color>
    <Color x:Key="CardColor">#FFFFFF</Color>
    <Color x:Key="FieldColor">#F7F7F4</Color>
    <Color x:Key="TrackColor">#ECECE6</Color>
    <Color x:Key="TextColor">#2B2B28</Color>
    <Color x:Key="SubTextColor">#8A8A84</Color>
    <Color x:Key="DividerColor">#E3E3DD</Color>
    <Color x:Key="ConsoleColor">#FBFBF9</Color>
    <Color x:Key="SuccessColor">#168A50</Color>
    <Color x:Key="DangerColor">#C4554D</Color>
    <Color x:Key="InfoColor">#4E7FA6</Color>
    <!-- 中性交互反馈（深浅色模式下分别取黑/白叠加） -->
    <Color x:Key="HoverColor">#12000000</Color>
    <Color x:Key="PressedColor">#1E000000</Color>
    <!-- 滚动条滑块（深色模式翻转为白色叠加，避免黑条隐身） -->
    <Color x:Key="ThumbColor">#28000000</Color>
    <Color x:Key="ThumbHoverColor">#48000000</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{DynamicResource PrimaryColor}" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{DynamicResource PrimaryHoverColor}" />
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="{DynamicResource PrimaryPressedColor}" />
    <SolidColorBrush x:Key="PrimarySoftBrush" Color="{DynamicResource PrimarySoftColor}" />
    <SolidColorBrush x:Key="OnPrimaryBrush" Color="{DynamicResource OnPrimaryColor}" />
    <SolidColorBrush x:Key="OnPrimarySubBrush" Color="{DynamicResource OnPrimarySubColor}" />
    <SolidColorBrush x:Key="OverlaySoftBrush" Color="{DynamicResource OverlaySoftColor}" />
    <SolidColorBrush x:Key="OverlayHoverBrush" Color="{DynamicResource OverlayHoverColor}" />
    <SolidColorBrush x:Key="OverlayPressedBrush" Color="{DynamicResource OverlayPressedColor}" />
    <SolidColorBrush x:Key="BackgroundBrush" Color="{DynamicResource BackgroundColor}" />
    <SolidColorBrush x:Key="CardBrush" Color="{DynamicResource CardColor}" />
    <SolidColorBrush x:Key="FieldBrush" Color="{DynamicResource FieldColor}" />
    <SolidColorBrush x:Key="TrackBrush" Color="{DynamicResource TrackColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="SubTextBrush" Color="{DynamicResource SubTextColor}" />
    <SolidColorBrush x:Key="DividerBrush" Color="{DynamicResource DividerColor}" />
    <SolidColorBrush x:Key="ConsoleBrush" Color="{DynamicResource ConsoleColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{DynamicResource SuccessColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{DynamicResource DangerColor}" />
    <SolidColorBrush x:Key="InfoBrush" Color="{DynamicResource InfoColor}" />

    <!-- 中性交互反馈（随深浅色模式切换） -->
    <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource HoverColor}" />
    <SolidColorBrush x:Key="PressedBrush" Color="{DynamicResource PressedColor}" />
    <SolidColorBrush x:Key="ThumbBrush" Color="{DynamicResource ThumbColor}" />
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="{DynamicResource ThumbHoverColor}" />

</ResourceDictionary>
