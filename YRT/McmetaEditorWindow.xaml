<Window x:Class="YRT.McmetaEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑 pack.mcmeta" Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="{DynamicResource BackgroundBrush}"
        WindowStyle="ToolWindow">
    <StackPanel Margin="20,16">

        <TextBlock Text="编辑 pack.mcmeta" FontSize="17" FontWeight="Bold"
                   Foreground="{DynamicResource TextBrush}" />
        <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,0"
                   Text="修改包描述与格式版本后，将直接写回资源包（zip 内条目会被替换）。" />

        <!-- 包描述 -->
        <TextBlock Text="包描述：" Style="{StaticResource FieldLabel}" Margin="0,14,0,0" />
        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,6,0,0" MaxLength="120" />

        <!-- 格式版本 -->
        <TextBlock Text="pack_format（格式版本）：" Style="{StaticResource FieldLabel}" Margin="0,12,0,0" />
        <Grid Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{Binding PackFormatText, UpdateSourceTrigger=PropertyChanged}"
                     HorizontalContentAlignment="Center" FontFamily="Consolas" />
            <TextBlock Grid.Column="1" Style="{StaticResource HintText}" Margin="10,1,0,0"
                       VerticalAlignment="Center" TextWrapping="Wrap"
                       Text="15=1.20~1.20.1 · 22=1.20.3~4 · 32=1.20.5~6 · 34=1.21~1.21.1 · 42=1.21.2~3 · 46=1.21.4" />
        </Grid>
        <TextBlock Style="{StaticResource HintText}" Margin="0,6,0,0"
                   Text="{Binding FormatHint}" Foreground="{DynamicResource DangerBrush}" />

        <!-- 原文预览 -->
        <TextBlock Text="生成结果预览：" Style="{StaticResource FieldLabel}" Margin="0,12,0,0" />
        <Border Background="{DynamicResource ConsoleBrush}" CornerRadius="8" Padding="10,8" Margin="0,6,0,0">
            <TextBlock Text="{Binding Preview}" FontFamily="Consolas" FontSize="11.5"
                       TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" />
        </Border>

        <!-- 操作 -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,4">
            <Button Content="取消" Padding="18,7" IsCancel="True" />
            <Button Style="{StaticResource PrimaryButton}" Content="保存写回" Padding="18,7" Margin="10,0,0,0"
                    Click="Save_Click" />
        </StackPanel>
    </StackPanel>
</Window>
