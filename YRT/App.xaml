<Application x:Class="YRT.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="clr-namespace:YRT.Pages"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme/Colors.xaml" />
                <ResourceDictionary Source="Theme/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <pages:EmptyToVisConverter x:Key="EmptyToVis" />
            <pages:InverseBoolToVisConverter x:Key="InverseBoolToVis" />
            <pages:LogBrushConverter x:Key="LogBrush" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
